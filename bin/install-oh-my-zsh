#!/usr/bin/env bash
# Installs oh-my-zsh and the custom plugins referenced by zsh/.zshrc.
# Safe to re-run: every step is a no-op if already present.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"

ZSH_DIR="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH_DIR/custom}"

if [ ! -d "$ZSH_DIR" ]; then
  echo "Installing oh-my-zsh..."
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

install_plugin () {
  name="$1"
  repo="$2"
  dest="$ZSH_CUSTOM/plugins/$name"

  if [ ! -d "$dest" ]; then
    echo "Installing $name plugin..."
    git clone --depth=1 "$repo" "$dest"
  fi
}

install_plugin "zsh-autosuggestions" "https://github.com/zsh-users/zsh-autosuggestions"
install_plugin "zsh-completions" "https://github.com/zsh-users/zsh-completions"

# Custom theme overrides (take precedence over oh-my-zsh's built-in themes;
# see oh-my-zsh.sh's `is_theme "$ZSH_CUSTOM/themes" ...` check).
mkdir -p "$ZSH_CUSTOM/themes"
for theme in "$DOTFILES_DIR"/oh-my-zsh-custom/themes/*.zsh-theme; do
  [ -e "$theme" ] || continue
  ln -sf "$theme" "$ZSH_CUSTOM/themes/$(basename "$theme")"
done
